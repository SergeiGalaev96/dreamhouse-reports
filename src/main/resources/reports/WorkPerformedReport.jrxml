            <textField pattern="#,##0.##">
                <reportElement x="475" y="0" width="80" height="22"/>
                <box><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="22" width="475" height="22"/>
                <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="0.75"/><rightPen lineWidth="0.75"/></box>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                    <paragraph leftIndent="4"/>
                </textElement>
                <text><![CDATA[Аванс]]></text>
            </staticText>

            <textField pattern="#,##0.##">
                <reportElement x="475" y="22" width="80" height="22"/>
                <box><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{advancePayment}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="44" width="475" height="22"/>
                <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="0.75"/></box>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                    <paragraph leftIndent="4"/>
                </textElement>
                <text><![CDATA[Остаток]]></text>
            </staticText>

            <textField pattern="#,##0.##">
                <reportElement x="475" y="44" width="80" height="22"/>
                <box><leftPen lineWidth="0.75"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{remainingAmount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="72" width="555" height="18"/>
                <text><![CDATA[3. Стоимость услуг по данному акту составила:]]></text>
            </staticText>

            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="92" width="555" height="28"/>
                <textElement verticalAlignment="Top">
                    <font size="9" isBold="true" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalInWords}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="122" width="340" height="20"/>
                <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[От Заказчика:]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="122" width="215" height="20"/>
                <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[От Исполнителя]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="142" width="340" height="20"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA["Прораб:__________________" + $P{foremanSignatureName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="340" y="142" width="215" height="20"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{performerSignatureName} + "______________"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="162" width="340" height="20"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA["Инженер ПТО :  _________________" + $P{planningEngineerSignatureName}]]></textFieldExpression>
