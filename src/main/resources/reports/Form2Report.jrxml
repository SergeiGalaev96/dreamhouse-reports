<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Form2Report"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              uuid="92a63a9b-9c32-4e9d-9a3d-2f85c2b0b001">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" pdfEncoding="Identity-H" isPdfEmbedded="true"/>

    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="projectAddress" class="java.lang.String"/>
    <parameter name="constructionType" class="java.lang.String"/>
    <parameter name="reportNumber" class="java.lang.String"/>
    <parameter name="reportDateLabel" class="java.lang.String"/>
    <parameter name="periodFromLabel" class="java.lang.String"/>
    <parameter name="periodToLabel" class="java.lang.String"/>
    <parameter name="periodLabel" class="java.lang.String"/>
    <parameter name="foremanName" class="java.lang.String"/>

    <field name="row_no" class="java.lang.String"/>
    <field name="estimate_no" class="java.lang.String"/>
    <field name="item_name" class="java.lang.String"/>
    <field name="unit_name" class="java.lang.String"/>
    <field name="contract_quantity" class="java.lang.Double"/>
    <field name="contract_price" class="java.lang.Double"/>
    <field name="contract_amount" class="java.lang.Double"/>
    <field name="previous_quantity" class="java.lang.Double"/>
    <field name="previous_amount" class="java.lang.Double"/>
    <field name="period_quantity" class="java.lang.Double"/>
    <field name="period_amount" class="java.lang.Double"/>
    <field name="total_quantity" class="java.lang.Double"/>
    <field name="total_amount" class="java.lang.Double"/>
    <field name="completion_percent_label" class="java.lang.String"/>
    <field name="item_type" class="java.lang.String"/>

    <title>
        <band height="112">
            <textField>
                <reportElement x="0" y="0" width="520" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Заказчик: " + $P{customerName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="18" width="520" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Объект: " + $P{projectName} + ", " + $P{projectAddress}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="36" width="520" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Вид СМР: " + $P{constructionType}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="58" width="802" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="13"/>
                </textElement>
                <text><![CDATA[АКТ]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="78" width="802" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["выполненных работ за " + $P{periodLabel}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="54">
            <textField>
                <reportElement x="0" y="0" width="500" height="16"/>
                <textElement/>
                <textFieldExpression><![CDATA["№ документа: " + $P{reportNumber} + "    Дата: " + $P{reportDateLabel}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="500" y="0" width="302" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Отчетный период: " + $P{periodFromLabel} + " - " + $P{periodToLabel}]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement x="0" y="22" width="802" height="32"/>
                <staticText>
                    <reportElement x="0" y="0" width="34" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[№]]></text>
                </staticText>
                <staticText>
                    <reportElement x="34" y="0" width="46" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[Поз. сметы]]></text>
                </staticText>
                <staticText>
                    <reportElement x="80" y="0" width="240" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[Наименование работ]]></text>
                </staticText>
                <staticText>
                    <reportElement x="320" y="0" width="45" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[ед. изм.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="365" y="0" width="55" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[кол.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="420" y="0" width="60" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[цена]]></text>
                </staticText>
                <staticText>
                    <reportElement x="480" y="0" width="67" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[сумма]]></text>
                </staticText>
                <staticText>
                    <reportElement x="547" y="0" width="55" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[пред. кол.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="602" y="0" width="55" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[период кол.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="657" y="0" width="55" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[итого кол.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="712" y="0" width="55" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[итого сумма]]></text>
                </staticText>
                <staticText>
                    <reportElement x="767" y="0" width="35" height="32"/>
                    <box><topPen lineWidth="1"/><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement>
                    <text><![CDATA[(%)]]></text>
                </staticText>
            </frame>
        </band>
    </pageHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="34" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{row_no}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="34" y="0" width="46" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{estimate_no}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="80" y="0" width="240" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{item_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="45" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{unit_name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="365" y="0" width="55" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contract_quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="420" y="0" width="60" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contract_price}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="480" y="0" width="67" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contract_amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="547" y="0" width="55" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{previous_quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="602" y="0" width="55" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{period_quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="657" y="0" width="55" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="712" y="0" width="55" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="767" y="0" width="35" height="18"/>
                <box><leftPen lineWidth="1"/><bottomPen lineWidth="1"/><rightPen lineWidth="1"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{completion_percent_label}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="38">
            <textField>
                <reportElement x="0" y="18" width="300" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Прораб ____________________ " + $P{foremanName}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
