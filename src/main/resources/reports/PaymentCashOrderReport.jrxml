<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PaymentCashOrderReport"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40"
              topMargin="32" bottomMargin="32"
              uuid="1e6765a2-89d4-4a9f-a9be-0f95c8a78144">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Title" fontName="DejaVu Sans" fontSize="15" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Small" fontName="DejaVu Sans" fontSize="8" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Label" fontName="DejaVu Sans" fontSize="9" forecolor="#555555" pdfEncoding="Identity-H" isPdfEmbedded="true"/>

    <parameter name="orderTypeName" class="java.lang.String"/>
    <parameter name="orderShortName" class="java.lang.String"/>
    <parameter name="orderNumber" class="java.lang.String"/>
    <parameter name="orderDate" class="java.lang.String"/>
    <parameter name="organizationName" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="blockName" class="java.lang.String"/>
    <parameter name="articleName" class="java.lang.String"/>
    <parameter name="title" class="java.lang.String"/>
    <parameter name="statusName" class="java.lang.String"/>
    <parameter name="operationLabel" class="java.lang.String"/>
    <parameter name="counterpartyName" class="java.lang.String"/>
    <parameter name="counterpartyInn" class="java.lang.String"/>
    <parameter name="entityLabel" class="java.lang.String"/>
