                <textFieldExpression><![CDATA[$P{projectName} + ($P{blockName}.isBlank() ? "" : " / " + $P{blockName})]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="120" y="169" width="395" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="185" width="100" height="16" style="Label"/>
