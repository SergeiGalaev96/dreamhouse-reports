    <parameter name="currencyRateLabel" class="java.lang.String"/>
    <parameter name="amountInWords" class="java.lang.String"/>

    <title>
        <band height="720">
            <staticText>
                <reportElement x="0" y="0" width="515" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Унифицированная форма кассового ордера]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="42" width="515" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="15" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{orderTypeName}.toUpperCase()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="70" width="515" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{orderShortName} + " № " + $P{orderNumber} + " от " + $P{orderDate}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="115" width="100" height="16" style="Label"/>
                <text><![CDATA[Организация]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="120" y="112" width="395" height="22"/>
